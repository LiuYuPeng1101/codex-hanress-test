APP_NAME=Codex Agent Service
APP_ENV=production
API_PREFIX=/api/v1
AGENT_WORKSPACE=.
AGENT_ID=order-agent

# 必填：每个 Runtime Worker 唯一标识。它只作为短期 lease owner，不是永久 Thread 归属。
RUNTIME_INSTANCE_ID=agent-runtime-01
RUNTIME_LEASE_SECONDS=30

# 必填：Codex Thread 持久化目录。生产环境必须使用可恢复的持久存储。
CODEX_HOME=/var/lib/codex

# 必填：订单 MCP 经 agentgateway 暴露的受治理入口。Runtime 不允许直连真实 MCP Adapter。
AGENTGATEWAY_ORDER_MCP_URL=http://agentgateway:3000/mcp/order

# 必填：Agent Service 使用 RSA 私钥签发 5 分钟以内的 Runtime 内部 JWT。
# agentgateway 只配置对应公钥/JWKS；真实 ORDER_MCP_TOKEN 只放在 agentgateway backendAuth。
RUNTIME_IDENTITY_PRIVATE_KEY_PATH=/run/secrets/runtime-identity-private.pem
RUNTIME_IDENTITY_KEY_ID=runtime-key-1
RUNTIME_IDENTITY_ISSUER=agent-control-plane
RUNTIME_IDENTITY_AUDIENCE=agentgateway
RUNTIME_IDENTITY_TTL_SECONDS=300

# 必填：PostgreSQL。Conversation 与 Approval 都以数据库为事实来源。
DATABASE_URL=postgresql+psycopg://agent:change-me@postgres:5432/agent_runtime

# 必填：企业 Gateway 与 Agent Service 之间的服务认证密钥，至少 32 字符。
# 生产环境由 Secret Manager 注入，并建议叠加 mTLS / Service Mesh。
GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-characters

# 人工审批当前仍由 Codex approval handler 控制；后续将继续改为可恢复的 WAITING_APPROVAL 状态机。
APPROVAL_TIMEOUT_SECONDS=900

# 可选：OpenTelemetry OTLP HTTP Trace Endpoint。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
