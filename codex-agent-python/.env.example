APP_NAME=Codex Single Agent Service
APP_ENV=production
API_PREFIX=/api/v1
AGENT_ID=order-agent
AGENT_WORKSPACE=.

# Codex Thread 持久化目录。单实例部署也需要持久化，避免进程重启后无法 resume Thread。
CODEX_HOME=/var/lib/codex

# 当前单 Agent 的业务能力：订单 MCP Adapter。
ORDER_MCP_URL=http://order-mcp-adapter:8080/mcp
ORDER_MCP_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Conversation 与 Approval 持久化。
DATABASE_URL=postgresql+psycopg://agent:change-me@postgres:5432/agent_runtime

# 业务系统调用这个 Agent Service 的服务认证密钥。
API_SHARED_SECRET=replace-with-at-least-32-random-characters

# 可选：OpenTelemetry OTLP HTTP Trace Endpoint。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# ===== LangSmith Agent Eval =====
# LangSmith 只用于 Dataset / Experiment / Evaluator，不改变 Agent 的 Codex Harness Runtime。
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_EVAL_DATASET=codex-order-agent-seed
LANGSMITH_EXPERIMENT_PREFIX=order-agent
LANGSMITH_EVAL_MAX_CONCURRENCY=2

# Eval Target 通过当前 Agent Service 的公开 API 做黑盒评测。
EVAL_BASE_URL=http://127.0.0.1:8000
EVAL_API_SHARED_SECRET=replace-with-the-same-test-secret
EVAL_TIMEOUT_SECONDS=180

# 可选：配置后增加 OpenEvals LLM-as-a-Judge；未配置时只运行确定性 Evaluator。
# 示例值取决于你给 OpenEvals 配置的模型提供商。
EVAL_JUDGE_MODEL=
