APP_NAME=Codex Agent Service
APP_ENV=dev
API_PREFIX=/api/v1
AGENT_WORKSPACE=.

# Java 业务系统暴露的 MCP Server 地址。
# 如果 Python Agent 与 Java 服务运行在同一台机器，可继续使用 127.0.0.1。
ORDER_MCP_URL=http://127.0.0.1:8080/mcp

# 可选：OpenTelemetry OTLP HTTP Trace Endpoint。
# 留空时不发送远程 Trace；可接 Langfuse、Phoenix、Grafana Tempo 等 OTLP 后端。
# 不同平台的地址可能需要包含 /v1/traces，请以目标平台文档为准。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# 可选：部分 OTLP 平台需要认证 Header。OTel exporter 会读取标准环境变量。
# 示例格式由目标平台决定，不要把真实密钥提交到 Git。
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=...
