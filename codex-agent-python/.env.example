APP_NAME=Codex Single Agent Service
APP_ENV=production
API_PREFIX=/api/v1
AGENT_ID=order-agent
AGENT_WORKSPACE=.

# Codex Thread 持久化目录。单实例部署也需要持久化，避免进程重启后无法 resume Thread。
CODEX_HOME=/var/lib/codex

# 当前单 Agent 的业务能力：订单 MCP Adapter。
ORDER_MCP_URL=http://order-mcp-adapter:8080/mcp
ORDER_MCP_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Conversation 与 Approval 持久化。
DATABASE_URL=postgresql+psycopg://agent:change-me@postgres:5432/agent_runtime

# 业务系统调用这个 Agent Service 的服务认证密钥。
API_SHARED_SECRET=replace-with-at-least-32-random-characters

# 可选：OpenTelemetry OTLP HTTP Trace Endpoint。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
