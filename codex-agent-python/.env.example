APP_NAME=Codex Agent Service
APP_ENV=production
API_PREFIX=/api/v1
AGENT_WORKSPACE=/app

# 必填：订单 MCP Adapter 地址。
ORDER_MCP_URL=http://order-mcp-adapter:8080/mcp

# 必填：Approval Repository。生产环境必须使用可持久化、可多实例共享的 Redis。
REDIS_URL=redis://redis:6379/0
APPROVAL_WAIT_TIMEOUT_SECONDS=3600

# 可选：OpenTelemetry OTLP HTTP Trace Endpoint。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# 可选：目标 OTLP 平台需要认证时使用标准 OTel Header 配置。
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=...
